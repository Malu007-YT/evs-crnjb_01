# EV Scanner AI - Shadow Intelligence System
# Copia questo file in ".env" (stessa cartella) e valorizza con le TUE
# credenziali reali. Il file ".env" (senza .example) NON va mai committato
# in un repository Git ne' incluso in uno zip condiviso.
#
# NOTA IMPORTANTE: config/config.php del progetto PHP ha queste stesse
# credenziali scritte IN CHIARO nel codice sorgente. Vale la pena
# spostarle anche li' in variabili d'ambiente (es. vlucas/phpdotenv),
# cosi' un solo .env alimenta sia il lato PHP che Python.
#
# ----------------------------------------------------------------
# CONFIGURAZIONE HTTP PROXY (nuovo: sostituisce connessione DB diretta)
# ----------------------------------------------------------------
# URL completo dell'endpoint shadow_db_proxy.php deployato su InfinityFree
# Esempio: https://tuodominio.infinityfreeapp.com/worker/shadow_db_proxy.php
SHADOW_API_URL=https://dash.infinityfree.com/worker/shadow_db_proxy.php

# Bearer Token per autenticazione (deve coincidere con WORKER_SECRET_TOKEN in config/config.php
# oppure con variabile d'ambiente SHADOW_API_TOKEN lato PHP)
SHADOW_API_TOKEN=il_tuo_token_segreto_lungo_e_casuale

# ----------------------------------------------------------------
# DATABASE (MANTENUTO PER COMPATIBILITA' - non usato direttamente
# dal nuovo db_layer.py che passa via HTTP, ma serve a eventuali
# script legacy o tool di migrazione che usano ancora pymysql)
# ----------------------------------------------------------------
# Stessi valori di config/config.php: DB_HOST, DB_NAME, DB_USER, DB_PASS
DB_HOST=sql201.infinityfree.com
DB_PORT=3306
DB_NAME=if0_XXXXXXXX_ev_scanner
DB_USER=if0_XXXXXXXX
DB_PASSWORD=

# ----------------------------------------------------------------
# OPZIONALI - Per futuri servizi esterni Python-side
# ----------------------------------------------------------------
# API_KEYS per servizi di quote/risultati (se usati direttamente da Python)
# ODDS_API_KEY=
# API_SPORTS_KEY=
# SHARP_API_KEY=