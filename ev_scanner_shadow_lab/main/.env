# EV Scanner AI - Shadow Intelligence System
# Copia questo file in ".env" (stessa cartella) e valorizza con le TUE
# credenziali reali. Il file ".env" (senza .example) NON va mai committato
# in un repository Git ne' incluso in uno zip condiviso.
#
# NOTA IMPORTANTE: config/config.php del progetto PHP ha queste stesse
# credenziali scritte IN CHIARO nel codice sorgente. Vale la pena
# spostarle anche li' in variabili d'ambiente (es. vlucas/phpdotenv),
# cosi' un solo .env alimenta sia il lato PHP che Python.
#
# ----------------------------------------------------------------
# CONFIGURAZIONE HTTP PROXY (nuovo: sostituisce connessione DB diretta)
# ----------------------------------------------------------------
# URL completo dell'endpoint worker/resolve_bets_web.php deployato su
# InfinityFree. NON usare shadow_db_proxy.php: chiamato da GitHub Actions
# (client esterno non-browser) fa quasi sempre scattare la JS-challenge
# anti-bot di InfinityFree (risposta HTML/JS invece di JSON). Le azioni
# shadow_* sono state spostate/duplicate anche dentro resolve_bets_web.php,
# che è già l'endpoint collaudato per le chiamate esterne.
# Esempio: https://tuodominio.infinityfreeapp.com/worker/resolve_bets_web.php
SHADOW_API_URL=https://dash.infinityfree.com/worker/resolve_bets_web.php

# Token per autenticazione: DEVE coincidere con WORKER_SECRET_TOKEN in
# config/config.php. Non e' un Bearer header: db_layer.py lo manda come
# parametro di query string ?token=... (stesso schema di scan_web.php).
SHADOW_API_TOKEN=455bb9741e5aaf2a3fcb5537d089978944c10057829a6a02

# ----------------------------------------------------------------
# DATABASE (MANTENUTO PER COMPATIBILITA' - non usato direttamente
# dal nuovo db_layer.py che passa via HTTP, ma serve a eventuali
# script legacy o tool di migrazione che usano ancora pymysql)
# ----------------------------------------------------------------
# Stessi valori di config/config.php: DB_HOST, DB_NAME, DB_USER, DB_PASS
DB_HOST=sql201.infinityfree.com
DB_PORT=3306
DB_NAME=if0_42322915_ev_scanner
DB_USER=if0_42322915
DB_PASSWORD=Luciamattia22

